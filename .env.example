# ============================================================
# API Security Platform — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- Gateway Configuration ---
GATEWAY_PORT=3000
NODE_ENV=development

# --- JWT Configuration ---
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1h

# --- MongoDB Configuration ---
MONGO_URI=mongodb://mongodb:27017/api_security_platform
MONGO_DB_NAME=api_security_platform

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Backend Service URLs (internal Docker network) ---
USER_SERVICE_URL=http://user-service:4001
ORDER_SERVICE_URL=http://order-service:4002

# --- Backend Service Ports ---
USER_SERVICE_PORT=4001
ORDER_SERVICE_PORT=4002

# --- API Key for Testing ---
TEST_API_KEY=your-test-api-key-here
